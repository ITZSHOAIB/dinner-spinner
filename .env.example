# Copy this file to .env (or .env.production) and fill in values.
# Never commit the real .env — it's gitignored.

# Base URL where the app is deployed. Used for canonical, Open Graph,
# Twitter Card, and sitemap links in the built HTML.
#
# For the default Cloudflare Pages project. Change this to your custom domain
# after it is connected in the Cloudflare dashboard.
VITE_SITE_URL=https://dinner-spinner.pages.dev
